# ─── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://5321938.nl
NEXT_PUBLIC_SITE_NAME=5321938
NEXT_PUBLIC_SITE_TAGLINE=Het officiële supportersshirt
# Merkkleur (hex) voor knoppen/accenten
NEXT_PUBLIC_BRAND_COLOR=#e30613
NEXT_PUBLIC_CONTACT_EMAIL=info@5321938.nl
# Prefix voor ordernummers (bv. 5321-1001)
NEXT_PUBLIC_ORDER_PREFIX=5321-

# Verkopergegevens (verplicht voor voorwaarden/privacy/facturen)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_KVK=
NEXT_PUBLIC_COMPANY_BTW=

# ─── Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://lpweotxdrauwmgqstfmh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Kortingscodes (Stripe promotion codes) toestaan in checkout
STRIPE_ALLOW_PROMO_CODES=true

# ─── Verzending ──────────────────────────────────────────
SHIPPING_COUNTRIES=NL,BE
SHIPPING_COST_CENTS=495
SHIPPING_LABEL=Verzenden met track & trace
# Leeg laten = nooit gratis verzending
FREE_SHIPPING_FROM_CENTS=5000
# Afhalen aanbieden? (true/false) + omschrijving
PICKUP_ENABLED=false
PICKUP_LABEL=Gratis afhalen
NEXT_PUBLIC_DELIVERY_TIME=2–4 werkdagen

# ─── Resend (e-mail) ─────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=5321938 <bestellingen@5321938.nl>
# Kommagescheiden: wie krijgt de admin-ordermelding
ADMIN_NOTIFY_EMAILS=henk@example.nl

# ─── Sendcloud ───────────────────────────────────────────
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Automatisch zending aanmaken in Sendcloud na betaling (true/false)
SENDCLOUD_AUTO_CREATE=true
SENDCLOUD_WEIGHT_PER_ITEM_KG=0.25

# ─── Admin ───────────────────────────────────────────────
ADMIN_PASSWORD=
# Minimaal 32 willekeurige tekens (bv. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=
